{
  "expo": {
    "name": "Evaspoika",
    "slug": "Evaspoika",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/Logo.png",
    "scheme": "evaspoika",
    "userInterfaceStyle": "automatic",
   // "newArchEnabled": true,
    "extra": {
      "apiBaseUrl": "http://10.0.2.2:3000/api",
      "apiReadToken": "REMOVED-LEAKED-TOKEN-ROTATED-2026-08-12",
      "apiWriteToken": "REMOVED-LEAKED-TOKEN-ROTATED-2026-08-12",
      "netvisorReadToken": "REMOVED-LEAKED-TOKEN-ROTATED-2026-08-12",
      "netvisorWriteToken": "REMOVED-LEAKED-TOKEN-ROTATED-2026-08-12",
      "apiAdminToken": "REMOVED-LEAKED-TOKEN-ROTATED-2026-08-12"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/images/Logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Evaspoika"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/Logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
